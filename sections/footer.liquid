{% schema %}
{
  "name": "Footer Kings League",
  "settings": [
    {
      "type": "header",
      "content": "Configuración General"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Color de fondo principal",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Color de texto principal",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 20,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Espaciado superior",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 20,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Espaciado inferior",
      "default": 60
    },
    {
      "type": "header",
      "content": "Imagen de fondo del banner"
    },
    {
      "type": "checkbox",
      "id": "show_banner_image",
      "label": "Mostrar imagen de fondo en la parte superior",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "banner_background_image",
      "label": "Imagen de fondo del banner"
    },
    {
      "type": "color",
      "id": "banner_overlay_color",
      "label": "Color de overlay del banner",
      "default": "#FFA500"
    },
    {
      "type": "range",
      "id": "banner_overlay_opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Opacidad del overlay",
      "default": 80
    },
    {
      "type": "range",
      "id": "banner_height",
      "min": 200,
      "max": 500,
      "step": 10,
      "unit": "px",
      "label": "Altura del banner",
      "default": 300
    },
    {
      "type": "header",
      "content": "Logo"
    },
    {
      "type": "image_picker",
      "id": "footer_logo",
      "label": "Logo en pie de página"
    },
    {
      "type": "range",
      "id": "logo_width",
      "min": 100,
      "max": 300,
      "step": 10,
      "unit": "px",
      "label": "Ancho máximo del logo",
      "default": 150
    },
    {
      "type": "header",
      "content": "Sección Newsletter"
    },
    {
      "type": "checkbox",
      "id": "show_newsletter_image",
      "label": "Mostrar imagen superior en newsletter",
      "default": false
    },
    {
      "type": "image_picker",
      "id": "newsletter_top_image",
      "label": "Imagen superior del newsletter"
    },
    {
      "type": "range",
      "id": "newsletter_image_width",
      "min": 50,
      "max": 200,
      "step": 5,
      "unit": "px",
      "label": "Ancho de imagen newsletter",
      "default": 100
    },
    {
      "type": "range",
      "id": "newsletter_image_height",
      "min": 30,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Alto de imagen newsletter",
      "default": 60
    },
    {
      "type": "range",
      "id": "newsletter_image_margin_bottom",
      "min": 0,
      "max": 50,
      "step": 2,
      "unit": "px",
      "label": "Margen inferior imagen newsletter",
      "default": 10
    },
    {
      "type": "select",
      "id": "newsletter_image_position",
      "label": "Posición de imagen newsletter",
      "options": [
        {
          "value": "left",
          "label": "Izquierda"
        },
        {
          "value": "center",
          "label": "Centro"
        },
        {
          "value": "right",
          "label": "Derecha"
        }
      ],
      "default": "left"
    },
    {
      "type": "color",
      "id": "newsletter_background",
      "label": "Color de fondo del newsletter",
      "default": "#333333"
    },
    {
      "type": "text",
      "id": "newsletter_emoji",
      "label": "Emoji de cabecera del newsletter",
      "default": "🔥 ¡NO TE PIERDAS NADA! 🔥"
    },
    {
      "type": "color",
      "id": "newsletter_emoji_color",
      "label": "Color del emoji/texto superior",
      "default": "#FFA500"
    },
    {
      "type": "range",
      "id": "newsletter_emoji_size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Tamaño del texto emoji",
      "default": 16
    },
    {
      "type": "text",
      "id": "newsletter_title",
      "label": "Título del newsletter",
      "default": "📧 Recibe OFERTAS EXCLUSIVAS, REGALOS y BENEFICIOS ÚNICOS"
    },
    {
      "type": "color",
      "id": "newsletter_title_color",
      "label": "Color del título del newsletter",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "newsletter_title_size",
      "min": 18,
      "max": 36,
      "step": 1,
      "unit": "px",
      "label": "Tamaño del título",
      "default": 24
    },
    {
      "type": "text",
      "id": "newsletter_subtitle",
      "label": "Subtítulo del newsletter",
      "default": "⚽ ¡Sé el primero en enterarte de todo en la Kings League Americas!"
    },
    {
      "type": "color",
      "id": "newsletter_subtitle_color",
      "label": "Color del subtítulo",
      "default": "#cccccc"
    },
    {
      "type": "range",
      "id": "newsletter_subtitle_size",
      "min": 12,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Tamaño del subtítulo",
      "default": 14
    },
    {
      "type": "text",
      "id": "newsletter_placeholder",
      "label": "Texto del placeholder del email",
      "default": "su-email@ejemplo.com"
    },
    {
      "type": "color",
      "id": "newsletter_input_bg",
      "label": "Color de fondo del input",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "newsletter_button_bg",
      "label": "Color de fondo del botón",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "newsletter_button_text",
      "label": "Color del texto del botón",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Mensaje de Éxito Newsletter"
    },
    {
      "type": "checkbox",
      "id": "newsletter_show_success_icon",
      "label": "Mostrar icono en mensaje de éxito",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "newsletter_success_icon",
      "label": "Icono del mensaje de éxito"
    },
    {
      "type": "range",
      "id": "newsletter_success_icon_size",
      "min": 20,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Tamaño del icono",
      "default": 40
    },
    {
      "type": "text",
      "id": "newsletter_success_message",
      "label": "Mensaje de éxito",
      "default": "🎉 ¡Registro Exitoso, Gracias!"
    },
    {
      "type": "text",
      "id": "newsletter_success_subtitle",
      "label": "Subtítulo del mensaje de éxito",
      "default": "Te mantendremos informado de todas las novedades"
    },
    {
      "type": "color",
      "id": "newsletter_success_bg",
      "label": "Color de fondo del mensaje de éxito",
      "default": "#28a745"
    },
    {
      "type": "color",
      "id": "newsletter_success_text",
      "label": "Color del texto del mensaje de éxito",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "newsletter_success_title_size",
      "min": 16,
      "max": 36,
      "step": 1,
      "unit": "px",
      "label": "Tamaño del título del mensaje",
      "default": 24
    },
    {
      "type": "range",
      "id": "newsletter_success_subtitle_size",
      "min": 12,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Tamaño del subtítulo del mensaje",
      "default": 14
    },
    {
      "type": "range",
      "id": "newsletter_success_padding",
      "min": 15,
      "max": 60,
      "step": 5,
      "unit": "px",
      "label": "Padding interno del mensaje",
      "default": 30
    },
    {
      "type": "range",
      "id": "newsletter_success_margin",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Margen del mensaje",
      "default": 10
    },
    {
      "type": "range",
      "id": "newsletter_success_border_radius",
      "min": 0,
      "max": 25,
      "step": 1,
      "unit": "px",
      "label": "Redondeo de esquinas",
      "default": 12
    },
    {
      "type": "select",
      "id": "newsletter_success_animation",
      "label": "Tipo de animación",
      "options": [
        {
          "value": "fade_slide",
          "label": "Fade + Slide up"
        },
        {
          "value": "scale",
          "label": "Escala desde el centro"
        },
        {
          "value": "slide_down",
          "label": "Slide down"
        },
        {
          "value": "bounce",
          "label": "Bounce"
        }
      ],
      "default": "fade_slide"
    },
    {
      "type": "range",
      "id": "newsletter_success_duration",
      "min": 3,
      "max": 10,
      "step": 1,
      "unit": "s",
      "label": "Duración del mensaje (segundos)",
      "default": 5
    },
    {
      "type": "header",
      "content": "Términos y Condiciones"
    },
    {
      "type": "select",
      "id": "terms_layout",
      "label": "Layout de enlaces de términos",
      "options": [
        {
          "value": "expandable",
          "label": "Secciones expandibles con flechas"
        },
        {
          "value": "simple_list",
          "label": "Lista simple (como en referencias)"
        },
        {
          "value": "vertical",
          "label": "Lista vertical"
        },
        {
          "value": "horizontal",
          "label": "Menú horizontal"
        },
        {
          "value": "inline",
          "label": "En línea con separadores"
        }
      ],
      "default": "simple_list"
    },
    {
      "type": "text",
      "id": "terms_separator",
      "label": "Separador entre enlaces (solo para layout en línea)",
      "default": " | "
    },
    {
      "type": "header",
      "content": "Artículos del Blog - Términos y Condiciones"
    },
    {
      "type": "blog",
      "id": "terms_blog",
      "label": "Blog para términos y condiciones"
    },
    {
      "type": "article",
      "id": "privacy_policy_article",
      "label": "Artículo: Política de privacidad"
    },
    {
      "type": "text",
      "id": "privacy_policy_text",
      "label": "Texto política de privacidad",
      "default": "Política de privacidad"
    },
    {
      "type": "article",
      "id": "legal_notice_article",
      "label": "Artículo: Aviso legal"
    },
    {
      "type": "text",
      "id": "legal_notice_text",
      "label": "Texto aviso legal",
      "default": "Aviso legal"
    },
    {
      "type": "article",
      "id": "shipping_policy_article",
      "label": "Artículo: Política de envíos"
    },
    {
      "type": "text",
      "id": "shipping_policy_text",
      "label": "Texto política de envíos",
      "default": "Política de envíos"
    },
    {
      "type": "article",
      "id": "withdrawal_article",
      "label": "Artículo: Derecho de desistimiento"
    },
    {
      "type": "text",
      "id": "withdrawal_text",
      "label": "Texto derecho de desistimiento",
      "default": "Derecho de desistimiento"
    },
    {
      "type": "article",
      "id": "contact_article",
      "label": "Artículo: Información de contacto"
    },
    {
      "type": "text",
      "id": "contact_text",
      "label": "Texto contacto",
      "default": "Contacto"
    },
    {
      "type": "header",
      "content": "URLs Manuales (si no usas artículos)"
    },
    {
      "type": "text",
      "id": "privacy_policy_url",
      "label": "URL manual - Política de privacidad",
      "info": "Solo se usa si no seleccionas un artículo arriba",
      "default": "/policies/privacy-policy"
    },
    {
      "type": "text",
      "id": "shipping_policy_url",
      "label": "URL manual - Política de envíos",
      "info": "Solo se usa si no seleccionas un artículo arriba",
      "default": "/policies/shipping-policy"
    },
    {
      "type": "text",
      "id": "legal_notice_url",
      "label": "URL manual - Aviso legal",
      "info": "Solo se usa si no seleccionas un artículo arriba",
      "default": "/pages/legal"
    },
    {
      "type": "text",
      "id": "withdrawal_url",
      "label": "URL manual - Derecho de desistimiento",
      "info": "Solo se usa si no seleccionas un artículo arriba",
      "default": "/pages/desistimiento"
    },
    {
      "type": "text",
      "id": "contact_url",
      "label": "URL manual - Contacto",
      "info": "Solo se usa si no seleccionas un artículo arriba",
      "default": "/pages/contacto"
    },
    {
      "type": "header",
      "content": "Estilos de Términos"
    },
    {
      "type": "checkbox",
      "id": "show_terms_title",
      "label": "Mostrar título de términos y condiciones",
      "default": false
    },
    {
      "type": "text",
      "id": "terms_title",
      "label": "Título de la sección de términos",
      "default": "TÉRMINOS Y CONDICIONES"
    },
    {
      "type": "color",
      "id": "terms_title_color",
      "label": "Color del título de términos",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "terms_title_size",
      "min": 12,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Tamaño del título de términos",
      "default": 14
    },
    {
      "type": "color",
      "id": "terms_links_color",
      "label": "Color de los enlaces de términos",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "terms_links_hover_color",
      "label": "Color de los enlaces al hacer hover",
      "default": "#FFA500"
    },
    {
      "type": "color",
      "id": "terms_arrow_color",
      "label": "Color de las flechas (solo layout expandible)",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "terms_section_spacing",
      "min": 10,
      "max": 50,
      "step": 2,
      "unit": "px",
      "label": "Espaciado entre secciones expandibles",
      "default": 20
    },
    {
      "type": "header",
      "content": "Sección Kings League Tienda"
    },
    {
      "type": "text",
      "id": "store_title",
      "label": "Título de la sección tienda",
      "default": "KINGS LEAGUE TIENDA"
    },
    {
      "type": "color",
      "id": "store_title_color",
      "label": "Color del título de tienda",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "store_title_size",
      "min": 12,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Tamaño del título de tienda",
      "default": 14
    },
    {
      "type": "richtext",
      "id": "about_text",
      "label": "Texto descriptivo tienda",
      "default": "<p>Explora la exclusiva colección de camisetas y mercancía de los equipos de la innovadora Kings League Americas, fusionando moda y pasión deportiva única.</p>"
    },
    {
      "type": "color",
      "id": "about_text_color",
      "label": "Color del texto descriptivo",
      "default": "#cccccc"
    },
    {
      "type": "range",
      "id": "about_text_size",
      "min": 12,
      "max": 18,
      "step": 1,
      "unit": "px",
      "label": "Tamaño del texto descriptivo",
      "default": 14
    },
    {
      "type": "header",
      "content": "Redes Sociales - Configuración"
    },
    {
      "type": "text",
      "id": "social_title",
      "label": "Título de redes sociales",
      "default": "Redes Sociales"
    },
    {
      "type": "color",
      "id": "social_title_color",
      "label": "Color del título de redes sociales",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "social_title_size",
      "min": 12,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Tamaño del título de redes sociales",
      "default": 14
    },
    {
      "type": "color",
      "id": "social_icons_color",
      "label": "Color de los íconos sociales",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "social_icons_hover_color",
      "label": "Color de los íconos al hacer hover",
      "default": "#FFA500"
    },
    {
      "type": "range",
      "id": "social_icons_size",
      "min": 20,
      "max": 50,
      "step": 2,
      "unit": "px",
      "label": "Tamaño de los íconos sociales",
      "default": 28
    },
    {
      "type": "range",
      "id": "social_icons_spacing",
      "min": 5,
      "max": 30,
      "step": 1,
      "unit": "px",
      "label": "Espaciado entre íconos",
      "default": 15
    },
    {
      "type": "select",
      "id": "social_layout_desktop",
      "label": "Layout de redes sociales en desktop",
      "options": [
        {
          "value": "horizontal",
          "label": "Horizontal (una fila)"
        },
        {
          "value": "vertical",
          "label": "Vertical (una columna)"
        },
        {
          "value": "grid",
          "label": "Cuadrícula"
        }
      ],
      "default": "horizontal"
    },
    {
      "type": "select",
      "id": "social_layout_mobile",
      "label": "Layout de redes sociales en móvil",
      "options": [
        {
          "value": "horizontal",
          "label": "Horizontal centrado"
        },
        {
          "value": "grid",
          "label": "Cuadrícula centrada"
        }
      ],
      "default": "horizontal"
    },
    {
      "type": "checkbox",
      "id": "social_title_and_icons_inline",
      "label": "Mostrar título e íconos en la misma línea",
      "default": true
    },
    {
      "type": "header",
      "content": "Redes Sociales - Posicionamiento"
    },
    {
      "type": "select",
      "id": "social_position",
      "label": "Posición de redes sociales",
      "options": [
        {
          "value": "bottom",
          "label": "Parte inferior del footer"
        },
        {
          "value": "column",
          "label": "Como columna adicional"
        },
        {
          "value": "inside_column",
          "label": "Dentro de otra columna"
        }
      ],
      "default": "bottom"
    },
    {
      "type": "select",
      "id": "social_parent_column",
      "label": "Columna padre (solo si seleccionas 'Dentro de otra columna')",
      "options": [
        {
          "value": "terms",
          "label": "Columna de términos"
        },
        {
          "value": "store",
          "label": "Columna de tienda"
        },
        {
          "value": "newsletter",
          "label": "Columna de newsletter"
        }
      ],
      "default": "terms"
    },
    {
      "type": "range",
      "id": "social_section_margin_top",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "px",
      "label": "Margen superior sección redes sociales",
      "default": 15
    },
    {
      "type": "range",
      "id": "social_section_margin_bottom",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "px",
      "label": "Margen inferior sección redes sociales",
      "default": 0
    },
    {
      "type": "range",
      "id": "social_section_padding_top",
      "min": 0,
      "max": 60,
      "step": 5,
      "unit": "px",
      "label": "Padding superior sección redes sociales",
      "default": 0
    },
    {
      "type": "range",
      "id": "social_section_padding_bottom",
      "min": 0,
      "max": 60,
      "step": 5,
      "unit": "px",
      "label": "Padding inferior sección redes sociales",
      "default": 0
    },
    {
      "type": "header",
      "content": "Redes Sociales - Móviles"
    },
    {
      "type": "range",
      "id": "social_mobile_margin_top",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Margen superior en móvil",
      "default": 10
    },
    {
      "type": "range",
      "id": "social_mobile_margin_bottom",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Margen inferior en móvil",
      "default": 0
    },
    {
      "type": "range",
      "id": "social_mobile_padding_top",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Padding superior en móvil",
      "default": 0
    },
    {
      "type": "range",
      "id": "social_mobile_padding_bottom",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Padding inferior en móvil",
      "default": 0
    },
    {
      "type": "select",
      "id": "social_mobile_alignment",
      "label": "Alineación en móvil",
      "options": [
        {
          "value": "left",
          "label": "Izquierda"
        },
        {
          "value": "center",
          "label": "Centro"
        },
        {
          "value": "right",
          "label": "Derecha"
        }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "Layout Responsive"
    },
    {
      "type": "select",
      "id": "desktop_layout",
      "label": "Layout en desktop",
      "options": [
        {
          "value": "three_columns",
          "label": "3 columnas"
        },
        {
          "value": "two_columns_left",
          "label": "2 columnas (términos y tienda izq.)"
        },
        {
          "value": "two_columns",
          "label": "2 columnas iguales"
        },
        {
          "value": "single_column",
          "label": "1 columna"
        }
      ],
      "default": "two_columns_left"
    },
    {
      "type": "select",
      "id": "mobile_layout",
      "label": "Layout en móvil",
      "options": [
        {
          "value": "stacked",
          "label": "Apilado vertical"
        },
        {
          "value": "collapsed",
          "label": "Secciones colapsables"
        }
      ],
      "default": "stacked"
    },
    {
      "type": "range",
      "id": "columns_gap",
      "min": 20,
      "max": 80,
      "step": 5,
