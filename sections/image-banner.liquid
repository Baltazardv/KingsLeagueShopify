{% comment %}
  Sección de columnas con iconos y texto.
  - Muestra hasta 4 columnas en escritorio.
  - Se apilan en 2x2 en tabletas y 1 columna en móviles.
  - Cada columna es un bloque editable.
{% endcomment %}

<style>
  .icon-columns-section-{{ section.id }} {
    padding: {{ section.settings.padding_vertical }}px 0;
    background-color: {{ section.settings.background_color }};
    color: {{ section.settings.text_color }};
    
    /* Variables CSS para tamaños de fuente editables */
    --icon-title-size: {{ section.settings.title_font_size | default: 18 | divided_by: 10.0 }}rem;
    --icon-text-size: {{ section.settings.text_font_size | default: 14 | divided_by: 10.0 }}rem;
    --icon-title-size-mobile: {{ section.settings.title_font_size_mobile | default: 16 | divided_by: 10.0 }}rem;
    --icon-text-size-mobile: {{ section.settings.text_font_size_mobile | default: 13 | divided_by: 10.0 }}rem;
  }

  .icon-columns-grid-{{ section.id }} {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2rem;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1rem;
  }

  .icon-column-{{ section.id }} {
    text-align: center;
  }

  .icon-column-{{ section.id }} svg {
    width: {{ section.settings.icon_size | default: 40 }}px;
    height: {{ section.settings.icon_size | default: 40 }}px;
    margin: 0 auto 1rem auto;
    color: {{ section.settings.icon_color }};
  }

  .icon-column-title-{{ section.id }} {
    font-family: 'Matrice', sans-serif;
    font-weight: 900;
    text-transform: uppercase;
    font-size: var(--icon-title-size);
    margin-bottom: 0.5rem;
    line-height: {{ section.settings.title_line_height | default: 1.2 }};
  }

  .icon-column-text-{{ section.id }} {
    font-family: 'Archivo', sans-serif;
    font-size: var(--icon-text-size);
    line-height: {{ section.settings.text_line_height | default: 1.5 }};
    opacity: 0.7;
  }

  /* --- Media Queries para Responsividad --- */
  @media (max-width: 990px) {
    .icon-columns-grid-{{ section.id }} {
      grid-template-columns: repeat(2, 1fr);
      gap: 2.5rem 1.5rem;
    }
  }

  @media (max-width: 767px) {
    .icon-columns-grid-{{ section.id }} {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
    
    .icon-column-title-{{ section.id }} {
      font-size: var(--icon-title-size-mobile);
    }

    .icon-column-text-{{ section.id }} {
      font-size: var(--icon-text-size-mobile);
    }

    .icon-column-{{ section.id }} svg {
      width: {{ section.settings.icon_size_mobile | default: 36 }}px;
      height: {{ section.settings.icon_size_mobile | default: 36 }}px;
    }
  }
</style>

<div class="icon-columns-section-{{ section.id }}">
  <div class="icon-columns-grid-{{ section.id }}">
    {%- for block in section.blocks -%}
      <div class="icon-column-{{ section.id }}">
        {%- if block.settings.icon != blank -%}
          {{ block.settings.icon }}
        {%- endif -%}
        {%- if block.settings.title != blank -%}
          <h3 class="icon-column-title-{{ section.id }}">{{ block.settings.title | escape }}</h3>
        {%- endif -%}
        {%- if block.settings.text != blank -%}
          <p class="icon-column-text-{{ section.id }}">{{ block.settings.text | escape }}</p>
        {%- endif -%}
      </div>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Columnas con Iconos",
  "max_blocks": 4,
  "settings": [
    {
      "type": "header",
      "content": "Colores"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Color de Fondo",
      "default": "#1c1c1c"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Color del Texto",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Color de los Iconos",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Espaciado"
    },
    {
      "type": "range",
      "id": "padding_vertical",
      "min": 20, "max": 120, "step": 4, "unit": "px",
      "label": "Espaciado vertical",
      "default": 60
    },
    {
      "type": "header",
      "content": "Tamaños de Iconos"
    },
    {
      "type": "range",
      "id": "icon_size",
      "label": "Tamaño de iconos (escritorio)",
      "min": 20,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "icon_size_mobile",
      "label": "Tamaño de iconos (móvil)",
      "min": 18,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 36
    },
    {
      "type": "header",
      "content": "Tipografía - Títulos"
    },
    {
      "type": "range",
      "id": "title_font_size",
      "label": "Tamaño de títulos (escritorio)",
      "min": 12,
      "max": 36,
      "step": 1,
      "unit": "px",
      "default": 18
    },
    {
      "type": "range",
      "id": "title_font_size_mobile",
      "label": "Tamaño de títulos (móvil)",
      "min": 12,
      "max": 28,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "title_line_height",
      "label": "Altura de línea - títulos",
      "min": 1.0,
      "max": 2.0,
      "step": 0.1,
      "default": 1.2
    },
    {
      "type": "header",
      "content": "Tipografía - Texto"
    },
    {
      "type": "range",
      "id": "text_font_size",
      "label": "Tamaño del texto (escritorio)",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "text_font_size_mobile",
      "label": "Tamaño del texto (móvil)",
      "min": 10,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 13
    },
    {
      "type": "range",
      "id": "text_line_height",
      "label": "Altura de línea - texto",
      "min": 1.0,
      "max": 2.5,
      "step": 0.1,
      "default": 1.5
    }
  ],
  "blocks": [
    {
      "type": "column",
      "name": "Columna",
      "settings": [
        {
          "type": "html",
          "id": "icon",
          "label": "Icono (SVG)",
          "info": "Pega tu código SVG aquí. Busca iconos en sitios como heroicons.com"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Título",
          "default": "Título de la Columna"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Texto",
          "default": "Describe brevemente el beneficio o la característica aquí."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Columnas con Iconos",
      "blocks": [
        { "type": "column", "settings": { "title": "Envío Internacionales" } },
        { "type": "column", "settings": { "title": "Producto Oficial" } },
        { "type": "column", "settings": { "title": "Pago Seguro" } },
        { "type": "column", "settings": { "title": "Atención al Cliente" } }
      ]
    }
  ]
}
{% endschema %}